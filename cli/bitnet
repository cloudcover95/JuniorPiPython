#!/usr/bin/env python3
# BitNet CLI

import argparse
from bitnet.inference.engine import BitNetEngine

def main():
    p = argparse.ArgumentParser()
    p.add_argument("prompt", nargs="?", default="Hello")
    p.add_argument("--tokens", type=int, default=64)
    args = p.parse_args()
    eng = BitNetEngine({"layer_sizes": [128, 256, 128]})
    print(eng.generate(args.prompt, max_tokens=args.tokens))

if __name__ == "__main__":
    main()