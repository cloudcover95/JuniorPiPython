#!/usr/bin/env python3
# BitNet CLI

import argparse
from bitnet.inference.engine import BitNetEngine

def main():
    parser = argparse.ArgumentParser(description="BitNet CLI")
    parser.add_argument("prompt", nargs="?", default="Hello")
    parser.add_argument("--max-tokens", type=int, default=64)
    args = parser.parse_args()
    engine = BitNetEngine({"layer_sizes": [128, 256, 128]})
    print(engine.generate(args.prompt, max_tokens=args.max_tokens))

if __name__ == "__main__":
    main()