#!/usr/bin/env python
# BitNet CLI - pip installable style

import argparse
from bitnet.inference.engine import BitNetEngine

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("prompt", nargs="?", default="Hello world")
    parser.add_argument("--max-tokens", type=int, default=64)
    args = parser.parse_args()

    engine = BitNetEngine({"layer_sizes": [128, 256, 128]})
    result = engine.generate(args.prompt, max_tokens=args.max_tokens)
    print(result)

if __name__ == "__main__":
    main()